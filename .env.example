# Phase 1: credentials used only to bootstrap PostgreSQL and prove the app works.
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password
TODO_BOOTSTRAP_PASSWORD=replace-with-a-different-bootstrap-password

# Existing Vault cluster. Authenticate separately with `vault login` or VAULT_TOKEN.
VAULT_ADDR=https://vault.example.com:8200
# Optional when pods need a different Vault endpoint than the local CLI.
# VSO_VAULT_ADDR=https://vault.internal.example.com:8200
# Optional path to the Vault CA certificate for the CLI and VSO VaultConnection.
# VAULT_CACERT=/absolute/path/to/vault-ca.pem
# Set only for a disposable lab when Vault uses an untrusted certificate.
VAULT_SKIP_VERIFY=false

# PostgreSQL address reachable from every Vault node, for example a private
# LoadBalancer or <kubernetes-node-ip>:30432 when using the optional NodePort.
VAULT_DB_ADDRESS=postgres.example.internal:5432
POSTGRES_DB_NAME=todo
POSTGRES_SSLMODE=disable
VAULT_DB_DEFAULT_TTL=30s
VAULT_DB_MAX_TTL=2m

# Kubernetes API endpoint reachable from the external Vault nodes. Required
# when the current kubeconfig advertises localhost/127.0.0.1.
# KUBERNETES_HOST_FOR_VAULT=https://kubernetes-api.example.internal:6443
